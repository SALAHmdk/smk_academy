# Copier vers .env.local (jamais commité). Valeurs disponibles dans Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Clé publishable (sb_publishable_...) : publique par conception, protégée par les politiques RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Ne JAMAIS ajouter ici la clé secrète / service_role.

# --- Paiements Stripe (MODE TEST uniquement : une clé sk_live_ est refusée) — variables serveur, jamais NEXT_PUBLIC ---
# Stripe > Développeurs > Clés API (mode test)
STRIPE_SECRET_KEY=sk_test_xxx
# Stripe > Développeurs > Webhooks > endpoint https://<site>/api/webhooks/stripe > Secret de signature
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Jeton aléatoire (≥ 32 caractères) ; seule son empreinte SHA-256 est enregistrée dans private.app_secrets
PAYMENTS_WEBHOOK_TOKEN=
